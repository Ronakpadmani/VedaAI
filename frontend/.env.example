# Local dev: talk directly to Express on port 4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Vercel option A — direct backend URL (set in Vercel dashboard, redeploy)
# NEXT_PUBLIC_API_URL=https://your-api.railway.app
# NEXT_PUBLIC_WS_URL=https://your-api.railway.app

# Vercel option B — proxy REST via Next.js (server-only, no NEXT_PUBLIC_API_URL)
# API_PROXY_URL=https://your-api.railway.app
# NEXT_PUBLIC_WS_URL=https://your-api.railway.app
