PORT=4000
# Atlas: Connect → Drivers → Node.js (NOT SQL Interface / query.mongodb.net)
MONGODB_URI=mongodb://localhost:27017/vedaai
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000
# Multiple origins (comma-separated) for Vercel previews:
# CORS_ORIGIN=https://veda-ai-gamma.vercel.app,https://veda-ai.vercel.app
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Single Render web service: process queue in the same container
START_INLINE_WORKER=true
